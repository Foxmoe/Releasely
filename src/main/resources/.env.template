# Database Configuration
DB_USERNAME=releasely
DB_PASSWORD=your_secure_password_here

# JWT Secret Key (HS256, at least 32 characters)
# 生产环境必须设置复杂的随机密钥，重启后token不会失效
# 多实例部署时所有实例必须使用相同的密钥
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_here

# JWT Refresh Token Configuration (days)
JWT_REFRESH_TOKEN_EXPIRATION=7

# Application Encryption
ENCRYPTION_MASTER_KEY=your_32_character_master_key_here

# API Request Signature Key (HMAC-SHA256)
# 用于验证 API 请求签名，防止请求被篡改
# 生产环境必须设置复杂的随机密钥（建议 64 位以上）
API_SIGNATURE_KEY=your_signature_secret_key_here_change_in_production

# Spring Boot Profile (dev / prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port (prod 默认 8443，dev 默认 8080)
SERVER_PORT=8080

# SSL / HTTPS Configuration
# 当使用反向代理（Nginx/Caddy）时，保持 SSL_ENABLED=false，由代理层处理 HTTPS
# 当直接暴露服务时，设置 SSL_ENABLED=true 并填写以下 keystore 配置
SSL_ENABLED=false
SSL_KEYSTORE_PATH=/path/to/keystore.p12
SSL_KEYSTORE_PASSWORD=your_keystore_password
SSL_KEYSTORE_TYPE=PKCS12
SSL_KEY_ALIAS=releasely

# 反向代理 X-Forwarded-* 头信任策略
# native = 信任所有反向代理头（适合单节点部署）
# framework = 仅信任 Spring 框架默认配置
# none = 不信任任何转发头
SERVER_FORWARD_HEADERS_STRATEGY=native

# AI 健康建议配置（预留接口，对接 Claude/OpenAI）
# API Key from Anthropic/OpenAI dashboard
AI_API_KEY=your_ai_api_key_here
# AI Provider: "claude" or "openai"
AI_PROVIDER=claude
# Model name (e.g., claude-sonnet-4-20250514 for Claude, gpt-4o for OpenAI)
AI_MODEL=claude-sonnet-4-20250514

# GDPR/个人信息保护法合规配置
# 数据主体请求自动处理（建议生产环境启用以加快处理速度）
PRIVACY_REQUEST_AUTO_APPROVE=false
# 数据导出请求保留天数（超过后自动清理）
DATA_EXPORT_RETENTION_DAYS=90
# 管理员用户名（用于处理隐私请求）
ADMIN_USERNAME=admin

# 数据导出 API（GET /api/auth/export - JWT认证，返回完整用户数据JSON）
#            （GET /api/auth/export/file - JWT认证，返回附件下载形式）
