CREATE TABLE Medication (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    dosage TEXT NOT NULL,
    reminder_time INTEGER NOT NULL,
    last_taken INTEGER,
    is_active INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

getAllMedications:
SELECT * FROM Medication WHERE is_active = 1 ORDER BY reminder_time ASC;

getMedicationById:
SELECT * FROM Medication WHERE id = ?;

insertMedication:
INSERT INTO Medication(id, name, dosage, reminder_time, last_taken, is_active, created_at)
VALUES (?, ?, ?, ?, NULL, 1, strftime('%s', 'now'));

updateMedication:
UPDATE Medication
SET name = ?, dosage = ?, reminder_time = ?, last_taken = ?
WHERE id = ?;

deleteMedication:
UPDATE Medication SET is_active = 0 WHERE id = ?;

markTaken:
UPDATE Medication SET last_taken = strftime('%s', 'now') WHERE id = ?;

getActiveMedications:
SELECT * FROM Medication WHERE is_active = 1 ORDER BY reminder_time ASC;

countMedications:
SELECT COUNT(*) FROM Medication WHERE is_active = 1;