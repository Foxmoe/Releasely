CREATE TABLE Cycle (
    id TEXT NOT NULL PRIMARY KEY,
    start_date INTEGER NOT NULL,
    duration INTEGER,
    predicted_next INTEGER,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

getAllCycles:
SELECT * FROM Cycle WHERE is_deleted = 0 ORDER BY start_date DESC;

getCycleById:
SELECT * FROM Cycle WHERE id = ?;

insertCycle:
INSERT INTO Cycle(id, start_date, duration, predicted_next, is_deleted, created_at)
VALUES (?, ?, ?, ?, 0, strftime('%s', 'now'));

updateCycle:
UPDATE Cycle
SET start_date = ?, duration = ?, predicted_next = ?
WHERE id = ?;

deleteCycle:
UPDATE Cycle SET is_deleted = 1 WHERE id = ?;

getLatestCycle:
SELECT * FROM Cycle WHERE is_deleted = 0 ORDER BY start_date DESC LIMIT 1;

countCycles:
SELECT COUNT(*) FROM Cycle WHERE is_deleted = 0;