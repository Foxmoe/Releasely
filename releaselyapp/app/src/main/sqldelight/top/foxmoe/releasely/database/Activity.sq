CREATE TABLE Activity (
    id TEXT NOT NULL PRIMARY KEY,
    date INTEGER NOT NULL,
    type TEXT NOT NULL,
    protection INTEGER NOT NULL DEFAULT 0,
    pleasure INTEGER,
    mood TEXT,
    notes TEXT,
    partner_id TEXT,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

getAllActivities:
SELECT * FROM Activity ORDER BY date DESC;

getActivityById:
SELECT * FROM Activity WHERE id = ?;

insertActivity:
INSERT INTO Activity(id, date, type, protection, pleasure, mood, notes, partner_id, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, strftime('%s', 'now'));

updateActivity:
UPDATE Activity
SET date = ?, type = ?, protection = ?, pleasure = ?, mood = ?, notes = ?, partner_id = ?
WHERE id = ?;

deleteActivity:
DELETE FROM Activity WHERE id = ?;

getActivitiesByDateRange:
SELECT * FROM Activity WHERE date >= ? AND date <= ? ORDER BY date DESC;

countActivities:
SELECT COUNT(*) FROM Activity;