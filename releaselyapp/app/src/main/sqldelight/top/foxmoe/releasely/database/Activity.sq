CREATE TABLE Activity (
    id TEXT NOT NULL PRIMARY KEY,
    server_id TEXT,
    date INTEGER NOT NULL,
    type TEXT NOT NULL,
    protection INTEGER NOT NULL DEFAULT 0,
    pleasure INTEGER,
    mood TEXT,
    notes TEXT,
    partner_id TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now')),
    updated_at INTEGER NOT NULL DEFAULT (strftime('%s', 'now'))
);

CREATE INDEX IF NOT EXISTS idx_activity_server_id ON Activity(server_id);
CREATE INDEX IF NOT EXISTS idx_activity_updated_at ON Activity(updated_at);

getAllActivities:
SELECT * FROM Activity WHERE is_deleted = 0 ORDER BY date DESC;

getActivityById:
SELECT * FROM Activity WHERE id = ?;

getActivityByServerId:
SELECT * FROM Activity WHERE server_id = ?;

insertActivity:
INSERT INTO Activity(id, server_id, date, type, protection, pleasure, mood, notes, partner_id, is_deleted, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0, strftime('%s', 'now'), strftime('%s', 'now'));

updateActivity:
UPDATE Activity
SET date = ?, type = ?, protection = ?, pleasure = ?, mood = ?, notes = ?, partner_id = ?, updated_at = strftime('%s', 'now')
WHERE id = ?;

markActivityDeleted:
UPDATE Activity SET is_deleted = 1, updated_at = strftime('%s', 'now') WHERE id = ?;

deleteActivityPermanently:
DELETE FROM Activity WHERE id = ?;

getActivitiesByDateRange:
SELECT * FROM Activity WHERE is_deleted = 0 AND date >= ? AND date <= ? ORDER BY date DESC;

getActivitiesUpdatedSince:
SELECT * FROM Activity WHERE updated_at > ?;

countActivities:
SELECT COUNT(*) FROM Activity WHERE is_deleted = 0;

setServerId:
UPDATE Activity SET server_id = ? WHERE id = ?;
